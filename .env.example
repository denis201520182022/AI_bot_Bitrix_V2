# Режим работы: local (JSON-файл + мок LLM) или prod (Redis + OpenAI)
APP_ENV=local

# --- OpenAI (только для prod) ---
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini
# Прокси-сервис OpenAI (base_url); пусто — официальное API
PROXY_SERVICE_URL= # устарело

# --- Bitrix24 ---
BITRIX_WEBHOOK=
BOT_ID=
CLIENT_ID=
# ID оператора для перевода диалогов (imopenlines.bot.session.transfer);
# пусто — перевод на оператора отключен
OPERATOR_ID=

PROMPT_FILE=src/prompt.txt

# --- Хранилище локального режима ---
STORAGE_FILE=data/storage.json

# --- Redis (только для prod) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Файл лога ---
LOG_FILE=logs/bot.log

# --- Сбор пачки сообщений (секунды) ---
MESSAGE_COLLECTION_WINDOW=20.0
MAX_COLLECTION_WINDOW=60.0
MESSAGE_CHECK_INTERVAL=0.5

# --- Поведение ответов ---
# Объединять пачку в одно сообщение и имитировать живого менеджера
COMBINE_MULTIPLE_MESSAGES=true
HUMANIZE_MODE=true

# --- OpenAI: таймаут (сек) и число повторных запросов ---
OPENAI_TIMEOUT=60
OPENAI_RETRIES=3

# --- Отложенный перевод на оператора после получения телефона (секунды) ---
PHONE_TRANSFER_DELAY=1800